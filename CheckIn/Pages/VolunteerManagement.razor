@page "/volunteers"

<PageTitle>Volunteer Management</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Volunteer Management</MudText>

@if (!AuthService.IsLoggedIn || !AuthService.CanManageVolunteers)
{
    <MudAlert Severity="Severity.Error">Access Denied.</MudAlert>
}
else
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialog" Class="mb-4">Add Volunteer</MudButton>

    <MudDataGrid Items="@_volunteers" T="VolunteerSummary" Hover="true">
        <Columns>
            <PropertyColumn Property="x => x.Username" Title="Username" />
            <PropertyColumn Property="x => x.Email" Title="Email" />
            <PropertyColumn Property="x => x.CanViewData" Title="View Data" />
            <PropertyColumn Property="x => x.CanAddUsers" Title="Add Users" />
            <PropertyColumn Property="x => x.CanManageEvents" Title="Manage Events" />
            <PropertyColumn Property="x => x.CanManageVolunteers" Title="Manage Admin" />
            <TemplateColumn>
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenEditDialog(context.Item))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Lock" OnClick="@(() => OpenPasswordDialog(context.Item))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteVolunteer(context.Item))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
}
