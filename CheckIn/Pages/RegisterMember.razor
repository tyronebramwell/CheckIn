@page "/register-member"

<PageTitle>Member Registration</PageTitle>

@if (!AuthService.IsLoggedIn || !AuthService.CanAddUsers)
{
    <MudAlert Severity="Severity.Error">Access Denied.</MudAlert>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Medium">
        <MudPaper Class="pa-6">
            <div class="d-flex justify-space-between align-center mb-4">
                <MudText Typo="Typo.h4">Register New Member</MudText>
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => NavigationManager.NavigateTo("/find-member"))">Back to Search</MudButton>
            </div>

            @if (!string.IsNullOrEmpty(_serverError))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="@(() => _serverError = null)">@_serverError</MudAlert>
            }

            @if (_registeredMember != null)
            {
                <MudAlert Severity="Severity.Success" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="@(() => _registeredMember = null)">
                    Member @_registeredMember.FirstName registered successfully! 
                    <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.QrCode" OnClick="ShowRegisteredQrCode" Class="ml-4">Show Login QR</MudButton>
                </MudAlert>
            }

            <MudForm @ref="_form" @bind-IsValid="@_success">
                <MudGrid>
                    <MudItem xs="12"><MudText Typo="Typo.h6">Quick Login (Mandatory)</MudText></MudItem>
                    
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Username" Required="true" RequiredError="Username is required" @bind-Value="_newMember.Username" Variant="Variant.Outlined" HelperText="For self-service check-in" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Password" Required="true" RequiredError="Password is required" @bind-Value="_newMember.Password" Variant="Variant.Outlined" InputType="InputType.Password" />
                    </MudItem>
                    
                    <MudItem xs="12"><MudDivider /></MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="First Name" Required="true" RequiredError="First name is required" @bind-Value="_newMember.FirstName" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Last Name" Required="true" RequiredError="Last name is required" @bind-Value="_newMember.LastName" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudDatePicker Label="Date of Birth" Required="true" RequiredError="Date of birth is required" @bind-Date="_dob" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Guardian 1 Name" Required="true" RequiredError="Guardian name is required" @bind-Value="_newMember.Guardian1Name" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Guardian 1 Phone" Required="true" RequiredError="Phone number is required" @bind-Value="_newMember.Guardian1Phone" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" Label="User Email" Required="true" RequiredError="Email is required" 
                                      Validation="@(new EmailAddressAttribute() {ErrorMessage = "The email address is invalid"})"
                                      @bind-Value="_newMember.UserEmail" Variant="Variant.Outlined" />
                    </MudItem>
                    
                    <MudItem xs="12"><MudDivider /></MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Guardian 2 Name" @bind-Value="_newMember.Guardian2Name" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Guardian 2 Phone" @bind-Value="_newMember.Guardian2Phone" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" Label="Notes" Lines="3" @bind-Value="_newMember.Notes" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudCheckBox T="bool" Label="Email QR Code to member immediately" @bind-Value="_newMember.AllowEmail" Color="Color.Primary" />
                    </MudItem>
                </MudGrid>

                <div class="mt-6">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="() => Register(true)" Disabled="@(!_success)">Register & Check-In</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" Class="ml-2" OnClick="() => Register(false)" Disabled="@(!_success)">Register Only</MudButton>
                </div>
            </MudForm>
        </MudPaper>
    </MudContainer>
}
