@page "/login"
@using BlazorCameraStreamer
@using CheckIn.Components.Backgrounds
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Login</PageTitle>

<div class="d-flex flex-column align-center justify-center" style="min-height: calc(100vh - 128px); width: 100%;">
    <CameraStreamer @ref="_cameraStreamer"
                    Autostart="true"
                    Class="camera-background" />

    <BackgroundSwitcher />

    <MudPaper Elevation="4" Class="pa-12 w-100" Style="border-radius: 15px; max-width: 500px; z-index: 1;">
        <MudText Typo="Typo.h3" Align="Align.Center" GutterBottom="true">Login</MudText>
        <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-10 grey-text">Sign in to begin</MudText>
        
        <MudTextField @bind-Value="_username" Label="Username" Variant="Variant.Outlined" Class="mt-6" Immediate="true" Style="font-size: 1.2rem;" />
        <MudTextField @bind-Value="_password" Label="Password" Variant="Variant.Outlined" InputType="InputType.Password" Class="mt-6" Immediate="true" Style="font-size: 1.2rem;" />
        
        <div class="d-flex justify-end mt-2">
            <MudLink Typo="Typo.body2" Color="Color.Primary" OnClick="OpenForgotPasswordDialog" Style="cursor: pointer">Forgotten Password?</MudLink>
        </div>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-10 py-4" OnClick="OnLogin" Size="Size.Large" Style="font-size: 1.2rem; border-radius: 10px;" Disabled="_isLoggingIn">
            @if (_isLoggingIn) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/> }
            Login
        </MudButton>
        
        <MudDivider Class="my-8" />
        
        <MudText Typo="Typo.caption" Align="Align.Center" Class="d-block grey-text text-center">
            Members can use their quick-login credentials for self-service check-in.
        </MudText>
        
        <div class="d-flex justify-center mt-6">
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="@(() => NavigationManager.NavigateTo("/"))">Back to Home</MudButton>
        </div>
    </MudPaper>

    <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-4" Style="z-index: 1; color: white; text-shadow: 1px 1px 2px black;">
        Build: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")
    </MudText>
</div>

@code {
    private CameraStreamer? _cameraStreamer;
    private string _username = "";
    private string _password = "";
    private bool _isLoggingIn = false;

    [Inject] private IDialogService DialogService { get; set; } = null!;

    private async Task OnLogin()
    {
        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))
        {
            Snackbar.Add("Please enter both username and password.", Severity.Warning);
            return;
        }

        _isLoggingIn = true;
        if (await AuthService.LoginAsync(_username, _password))
        {
            if (AuthService.MustChangePassword)
            {
                var options = new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false };
                var dialog = await DialogService.ShowAsync<CheckIn.Components.ForcePasswordResetDialog>("Update Your Password", options);
                var result = await dialog.Result;
                
                if (result == null || result.Canceled)
                {
                    AuthService.Logout();
                    _isLoggingIn = false;
                    return;
                }
            }

            Snackbar.Add("Login successful", Severity.Success);
            NavigationManager.NavigateTo("/");
        }
        else
        {
            Snackbar.Add("Login failed. Please check your credentials.", Severity.Error);
        }
        _isLoggingIn = false;
    }

    private async Task OpenForgotPasswordDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        await DialogService.ShowAsync<CheckIn.Components.ForgotPasswordDialog>("Forgotten Password", options);
    }
}
