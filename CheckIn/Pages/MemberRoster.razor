@page "/MemberRoster"

<PageTitle>Member Roster</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Member Roster</MudText>

@if (AuthService.CanManageVolunteers)
{
    <div class="mb-6">
        <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportToCsv">Export Full Roster</MudButton>
    </div>
}

@if (!AuthService.IsLoggedIn || !AuthService.CanViewData)
{
    <MudAlert Severity="Severity.Error">Access Denied.</MudAlert>
}
else
{
    <MudDataGrid Items="@_members" T="Member" Filterable="true" SortMode="SortMode.Multiple" Hover="true">
        <Columns>
            <PropertyColumn Property="x => x.FirstName" Title="First Name" />
            <PropertyColumn Property="x => x.LastName" Title="Last Name" />
            <PropertyColumn Property="x => x.DateOfBirth" Title="DOB" Format="dd/MM/yyyy" />
            <TemplateColumn CellClass="d-flex justify-end gap-2">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.QrCode" Color="Color.Info" OnClick="@(() => ShowQrCode(context.Item))" />
                    <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Primary" OnClick="@(() => ViewProfile(context.Item.MemberId))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
}
