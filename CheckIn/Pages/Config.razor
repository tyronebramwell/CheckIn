@page "/config"

<PageTitle>System Configuration</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudText Typo="Typo.h3" GutterBottom="true">System Settings</MudText>
    <MudText Typo="Typo.body1" Class="mb-8">Manage global behavior and terminal toggles.</MudText>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudPaper Class="pa-6">
            <MudGrid>
                <MudItem xs="12">
                    <MudText Typo="Typo.h6">General Settings</MudText>
                </MudItem>

                <MudItem xs="12" sm="8">
                    <MudTextField T="string" Label="Organization Name" @bind-Value="_orgName" Variant="Variant.Outlined" HelperText="Used as the sender name in emails." />
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-4" />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.h6">Registration Settings</MudText>
                </MudItem>
                
                <MudItem xs="12" sm="8" Class="d-flex align-center">
                    <div>
                        <MudText Typo="Typo.subtitle1">Allow Public Registration</MudText>
                        <MudText Typo="Typo.body2" Class="grey-text">Show the "New Member" button on the terminal landing page.</MudText>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="4" Class="d-flex justify-end align-center">
                    <MudSwitch T="bool" Value="_allowPublic" ValueChanged="OnAllowPublicChanged" Color="Color.Primary" />
                </MudItem>

                <MudItem xs="12" sm="8" Class="d-flex align-center">
                    <div>
                        <MudText Typo="Typo.subtitle1">CSV Backup Interval (Minutes)</MudText>
                        <MudText Typo="Typo.body2" Class="grey-text">Frequency of automatic CSV exports to the 'drive' folder.</MudText>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="4" Class="d-flex justify-end align-center">
                    <MudNumericField T="int" @bind-Value="_csvInterval" Min="1" Max="1440" Variant="Variant.Outlined" Style="width: 100px;" />
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-4" />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.h6">SMTP Email Settings (Gmail)</MudText>
                    <MudText Typo="Typo.caption" Class="grey-text">Configure Gmail SMTP to send QR codes. Use an "App Password" if 2FA is enabled.</MudText>
                </MudItem>

                <MudItem xs="12" sm="8">
                    <MudTextField T="string" Label="SMTP Host" @bind-Value="_smtpHost" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField T="string" Label="Port" @bind-Value="_smtpPort" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="SMTP Username (Email)" @bind-Value="_smtpUser" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="SMTP Password / App Password" @bind-Value="_smtpPass" InputType="InputType.Password" Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-4" />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.h6">Maintenance</MudText>
                </MudItem>
                
                <MudItem xs="12" sm="8" Class="d-flex align-center">
                    <div>
                        <MudText Typo="Typo.subtitle1">Sync CSV Files Now</MudText>
                        <MudText Typo="Typo.body2" Class="grey-text">Force an immediate backup of members and attendance to the CSV drive.</MudText>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="4" Class="d-flex justify-end align-center">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="SyncCsvs">Sync Now</MudButton>
                </MudItem>

            </MudGrid>

            <div class="mt-8 d-flex justify-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSettings" Disabled="_isSaving">
                    @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/> }
                    Save Changes
                </MudButton>
            </div>
        </MudPaper>
    }
</MudContainer>