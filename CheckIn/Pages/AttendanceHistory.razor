@page "/AttendanceHistory"

<PageTitle>Attendance History</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Attendance History</MudText>

<div class="mb-6 d-flex align-center gap-4">
    <MudDatePicker Label="Select Date" Date="_selectedDate" DateChanged="OnDateChanged" Variant="Variant.Outlined" Style="max-width: 300px" />
    @if (AuthService.CanManageVolunteers)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportToCsv" Class="mt-1">Export to CSV</MudButton>
    }
</div>

@if (!AuthService.IsLoggedIn || !AuthService.CanViewData)
{
    <MudAlert Severity="Severity.Error">Access Denied.</MudAlert>
}
else
{
    <MudDataGrid Items="@_historyLogs" T="AttendanceHistoryDto" Filterable="true" SortMode="SortMode.Multiple" Hover="true">
        <Columns>
            <PropertyColumn Property="x => x.FirstName" Title="First Name" />
            <PropertyColumn Property="x => x.LastName" Title="Last Name" />
            <PropertyColumn Property="x => x.EventName" Title="Event" />
            <PropertyColumn Property="x => x.CheckInTime" Title="Check-In" Format="dd/MM/yyyy HH:mm" />
            <PropertyColumn Property="x => x.CheckOutTime" Title="Check-Out" Format="dd/MM/yyyy HH:mm" />
            <TemplateColumn Title="Status">
                <CellTemplate>
                    @if (context.Item.CheckOutTime == null)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">On-Site</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Default" Size="Size.Small">Checked Out</MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn CellClass="d-flex justify-end">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Primary" OnClick="@(() => ViewProfile(context.Item.MemberId))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
}
