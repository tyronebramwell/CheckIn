@page "/public-register"
@using CheckInCommon.Models
@using System.ComponentModel.DataAnnotations
@inject HttpClient HttpClient
@inject AuthService AuthService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>New Member Registration</PageTitle>

<div class="d-flex flex-column align-center justify-center" style="min-height: calc(100vh - 128px); width: 100%;">
    <CheckIn.Components.Backgrounds.BackgroundSwitcher />
    
    <MudContainer MaxWidth="MaxWidth.Medium" Style="z-index: 1;">
        <MudPaper Class="pa-8" Style="border-radius: 15px;">
            <div class="d-flex justify-space-between align-center mb-6">
                <MudText Typo="Typo.h4">New Member Registration</MudText>
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => NavigationManager.NavigateTo("/"))">Back</MudButton>
            </div>

            @if (!string.IsNullOrEmpty(_serverError))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="@(() => _serverError = null)">@_serverError</MudAlert>
            }

            <MudForm @ref="_form" @bind-IsValid="@_success">
                <MudGrid>
                    <MudItem xs="12"><MudText Typo="Typo.h6">Step 1: Create Your Login</MudText></MudItem>
                    
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Username" Required="true" RequiredError="Pick a username" @bind-Value="_newMember.Username" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Password" Required="true" RequiredError="Create a password" @bind-Value="_newMember.Password" Variant="Variant.Outlined" InputType="InputType.Password" />
                    </MudItem>
                    
                    <MudItem xs="12"><MudDivider /></MudItem>
                    <MudItem xs="12"><MudText Typo="Typo.h6">Step 2: Member Details</MudText></MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="First Name" Required="true" RequiredError="First name is required" @bind-Value="_newMember.FirstName" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Last Name" Required="true" RequiredError="Last name is required" @bind-Value="_newMember.LastName" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudDatePicker Label="Date of Birth" Required="true" RequiredError="Date of birth is required" @bind-Date="_dob" Variant="Variant.Outlined" />
                    </MudItem>
                    
                    <MudItem xs="12"><MudDivider /></MudItem>
                    <MudItem xs="12"><MudText Typo="Typo.h6">Step 3: Emergency Contacts</MudText></MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Guardian Name" Required="true" RequiredError="Guardian name is required" @bind-Value="_newMember.Guardian1Name" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Guardian Phone" Required="true" RequiredError="Phone number is required" @bind-Value="_newMember.Guardian1Phone" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" Label="User Email" Required="true" RequiredError="Email is required"
                                      Validation="@(new EmailAddressAttribute() {ErrorMessage = "Invalid email"})"
                                      @bind-Value="_newMember.UserEmail" Variant="Variant.Outlined" />
                    </MudItem>

                    <MudItem xs="12"><MudDivider /></MudItem>
                    <MudItem xs="12"><MudText Typo="Typo.h6">Step 4: Optional Information</MudText></MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Guardian 2 Name" @bind-Value="_newMember.Guardian2Name" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Guardian 2 Phone" @bind-Value="_newMember.Guardian2Phone" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" Label="Notes" Lines="3" @bind-Value="_newMember.Notes" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudCheckBox T="bool" Label="Email my Login QR Code to me" @bind-Value="_newMember.AllowEmail" Color="Color.Primary" />
                    </MudItem>
                </MudGrid>

                <div class="mt-8 d-flex justify-center">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Style="height: 80px; width: 300px; font-size: 1.5rem; border-radius: 10px;" 
                               OnClick="RegisterAndCheckIn" Disabled="@(!_success || _isProcessing)">
                        @if (_isProcessing) { <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" /> }
                        Register & Finish
                    </MudButton>
                </div>
            </MudForm>
        </MudPaper>
    </MudContainer>
</div>

@code {
    private MudForm _form = null!;
    private bool _success;
    private bool _isProcessing = false;
    private string? _serverError;
    private MemberRegistrationDto _newMember = new();
    private DateTime? _dob = DateTime.Today;

    private async Task RegisterAndCheckIn()
    {
        _serverError = null;
        await _form.Validate();
        if (!_form.IsValid) return;

        _isProcessing = true;
        _newMember.DateOfBirth = DateOnly.FromDateTime(_dob ?? DateTime.Today);
        
        var response = await HttpClient.PostAsJsonAsync("/api/members/public", _newMember);

        if (response.IsSuccessStatusCode)
        {
            var member = await response.Content.ReadFromJsonAsync<Member>();
            if (member != null)
            {
                if (await AuthService.LoginAsync(_newMember.Username, _newMember.Password))
                {
                    var checkInResponse = await HttpClient.PostAsync("/api/attendance/self-check-in", null);
                    if (checkInResponse.IsSuccessStatusCode)
                    {
                        Snackbar.Add("Welcome! You are registered and checked in.", Severity.Success);
                        NavigationManager.NavigateTo("/");
                    }
                }
            }
        }
        else
        {
            _serverError = await response.Content.ReadAsStringAsync();
            if (string.IsNullOrEmpty(_serverError)) _serverError = "Registration failed. Please try again.";
        }
        _isProcessing = false;
    }
}
