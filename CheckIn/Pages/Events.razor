@page "/events"

<PageTitle>Event Management</PageTitle>

@if (!AuthService.IsLoggedIn || !AuthService.CanManageEvents)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
        <MudAlert Severity="Severity.Error">Access Denied. You do not have permission to manage events.</MudAlert>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h4">Event Management</MudText>
            <MudText Typo="Typo.body1" Class="grey-text">Create and manage simultaneous or recurring events.</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">Add Event</MudButton>
    </div>

    <MudDataGrid Items="@_events" T="Event" Hover="true" Bordered="true" Striped="true">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="Event Name" />
            <PropertyColumn Property="x => x.EventDate" Title="Date" Format="dd/MM/yyyy" />
            <TemplateColumn CellClass="d-flex justify-end">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteEvent(context.Item))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
</MudContainer>

<MudDialog @bind-Visible="_showCreateDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Create New Event</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_eventName" Label="Event Name" Variant="Variant.Outlined" Required="true" Class="mb-4" />
        <MudDatePicker @bind-Date="_eventDate" Label="Start Date" Variant="Variant.Outlined" Required="true" Class="mb-4" />
        
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">Recurrence</MudText>
        
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" Label="Repeat" @bind-Value="_repeatType" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("None")">Don't Repeat</MudSelectItem>
                    <MudSelectItem Value="@("Weekly")">Weekly</MudSelectItem>
                    <MudSelectItem Value="@("Bi-Weekly")">Bi-Weekly</MudSelectItem>
                    <MudSelectItem Value="@("Monthly")">Monthly</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="int" Label="Number of Times" @bind-Value="_repeatCount" Min="1" Max="52" Variant="Variant.Outlined" Disabled="@(_repeatType == "None")" HelperText="Total instances to create" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showCreateDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEvent">Create Event(s)</MudButton>
    </DialogActions>
</MudDialog>
}