@page "/not-found"
@layout MainLayout
<MudStack Style="align-content: center; margin: auto;">
    <h2 style="text-align: center">Not Found</h2>
    <MudImage Style="width: 30%; align-self: center" Src="@ErrorImage()"></MudImage>
<MudText style="text-align: center">Sorry, the content you are looking for was not found.</MudText>
<MudText style="text-align: center">Please go back to Home Page</MudText>
<MudButton Style="width: 30%; align-self: center" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Home" OnClick="@HomePage">Home</MudButton>
</MudStack>