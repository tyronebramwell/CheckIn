@page "/RecordView"

<PageTitle>Active Attendance</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Active Attendance</MudText>

@if (!AuthService.IsLoggedIn || !AuthService.CanViewData)
{
    <MudAlert Severity="Severity.Error">Access Denied.</MudAlert>
}
else
{
    <MudDataGrid Items="@_activeLogs" T="ActiveAttendanceDto" Filterable="true" SortMode="SortMode.Multiple">
        <Columns>
            <PropertyColumn Property="x => x.FirstName" Title="First Name" />
            <PropertyColumn Property="x => x.LastName" Title="Last Name" />
            <PropertyColumn Property="x => x.EventName" Title="Event" />
            <PropertyColumn Property="x => x.CheckInTime" Title="Check-In Time" Format="dd/MM/yyyy HH:mm" />
            <PropertyColumn Property="x => x.Notes" Title="Notes" />
            <TemplateColumn CellClass="d-flex justify-end gap-2">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Primary" OnClick="@(() => ViewProfile(context.Item.MemberId))" />
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@(() => CheckOut(context.Item))">Check Out</MudButton>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
}
