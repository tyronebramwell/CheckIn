@page "/edit-member/{MemberId:guid}"

<PageTitle>Edit Member Profile</PageTitle>

@if (!AuthService.IsLoggedIn || !AuthService.CanAddUsers)
{
    <MudAlert Severity="Severity.Error">Access Denied.</MudAlert>
}
else if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
}
else if (_memberDto == null)
{
    <MudAlert Severity="Severity.Error">Member not found.</MudAlert>
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => NavigationManager.NavigateTo("/find-member"))">Back to Search</MudButton>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Medium">
        <MudPaper Class="pa-6">
            <div class="d-flex justify-space-between align-center mb-4">
                <MudText Typo="Typo.h4">Edit Profile: @_memberDto.FirstName @_memberDto.LastName</MudText>
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.QrCode" OnClick="ShowQrCode">Show Login QR</MudButton>
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => NavigationManager.NavigateTo("/find-member"))">Back to Search</MudButton>
                </div>
            </div>
            
            <MudForm @ref="_form" @bind-IsValid="@_success">
                <MudGrid>
                    <MudItem xs="12"><MudText Typo="Typo.h6">Quick Login Details</MudText></MudItem>
                    
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Username" Required="true" RequiredError="Username is required" @bind-Value="_memberDto.Username" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Password" Required="true" RequiredError="Password is required" @bind-Value="_memberDto.Password" Variant="Variant.Outlined" InputType="InputType.Password" HelperText="Update password or leave as is." />
                    </MudItem>
                    
                    <MudItem xs="12"><MudDivider /></MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="First Name" Required="true" @bind-Value="_memberDto.FirstName" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Last Name" Required="true" @bind-Value="_memberDto.LastName" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudDatePicker Label="Date of Birth" Required="true" @bind-Date="_dob" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Guardian 1 Name" Required="true" @bind-Value="_memberDto.Guardian1Name" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Guardian 1 Phone" Required="true" @bind-Value="_memberDto.Guardian1Phone" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" Label="User Email" Required="true" @bind-Value="_memberDto.UserEmail" Variant="Variant.Outlined" />
                    </MudItem>
                    
                    <MudItem xs="12"><MudDivider /></MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Guardian 2 Name" @bind-Value="_memberDto.Guardian2Name" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Guardian 2 Phone" @bind-Value="_memberDto.Guardian2Phone" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" Label="Notes" Lines="3" @bind-Value="_memberDto.Notes" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudCheckBox T="bool" Label="Allow emailing QR Code to this member" @bind-Value="_memberDto.AllowEmail" Color="Color.Primary" />
                    </MudItem>
                </MudGrid>

                <div class="mt-6 d-flex gap-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="Save" Disabled="@(!_success || _isSaving)">
                        @if (_isSaving) { <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/> <MudText Class="ms-2">Saving...</MudText> }
                        else { <MudText>Save Changes</MudText> }
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Large" OnClick="@(() => NavigationManager.NavigateTo("/find-member"))">Cancel</MudButton>
                </div>
            </MudForm>
        </MudPaper>
    </MudContainer>
}