@page "/"

<PageTitle>Home</PageTitle>

<style>
    .burn-in-protection {
        animation: color-cycle 20s infinite alternate;
        z-index: 10;
        height: 200px; 
        width: 350px; 
        font-size: 1.8rem; 
        border-radius: 20px;
    }

    .qr-feedback-border {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 20px solid transparent;
        box-shadow: inset 0 0 100px transparent;
        pointer-events: none;
        z-index: 5;
        transition: all 0.3s ease-out;
    }

    .qr-feedback-border.success {
        border-color: #00FF41;
        box-shadow: inset 0 0 100px rgba(0, 255, 65, 0.5);
    }

    .qr-feedback-border.error {
        border-color: #FF5252;
        box-shadow: inset 0 0 100px rgba(255, 82, 82, 0.5);
    }

    .qr-action-message {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: rgba(0, 0, 0, 0.85);
        color: white;
        padding: 3rem 5rem;
        border-radius: 30px;
        z-index: 20;
        text-align: center;
        box-shadow: 0 0 50px rgba(0, 0, 0, 0.6);
        animation: message-pop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    /* Force the main layout to be transparent so we can see the camera */
    .mud-main-content {
        background-color: transparent !important;
    }
    
    .mud-container {
        background-color: transparent !important;
    }

    @@keyframes message-pop {
        0% { transform: translate(-50%, -50%) scale(0.7); opacity: 0; }
        100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    }

    @@keyframes color-cycle {
        0% { background-color: var(--mud-palette-primary); }
        25% { background-color: var(--mud-palette-secondary); }
        50% { background-color: var(--mud-palette-info); }
        75% { background-color: var(--mud-palette-warning); }
        100% { background-color: var(--mud-palette-success); }
    }

    .active-camera-anim {
        animation: color-cycle 20s infinite alternate !important;
        color: white !important;
    }
    
    /* Make sure the camera streamer fills the background */
    .camera-background {
        position: fixed !important;
        right: 0 !important;
        bottom: 0 !important;
        min-width: 100% !important;
        min-height: 100% !important;
        width: auto !important;
        height: auto !important;
        z-index: -100 !important;
        object-fit: cover !important;
    }
    
    .camera-background video {
        position: fixed !important;
        right: 0 !important;
        bottom: 0 !important;
        min-width: 100% !important;
        min-height: 100% !important;
        width: auto !important;
        height: auto !important;
        object-fit: cover !important;
    }
</style>

@if (!AuthService.IsLoggedIn || AuthService.IsMember)
{
    if (_isCheckingCamera)
    {
        <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 2000; background: rgba(0,0,0,0.9); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20px; text-align: center;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.h5" Style="color: white; margin-top: 20px;">Checking Camera Access...</MudText>
        </div>
    }
    else if (!_cameraSupported)
    {
        <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 2000; background: rgba(0,0,0,0.9); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20px; text-align: center;">
            <MudIcon Icon="@Icons.Material.Filled.VideocamOff" Color="Color.Error" Style="font-size: 6rem; margin-bottom: 20px;" />
            <MudText Typo="Typo.h4" Style="color: white; margin-bottom: 15px;">Camera Blocked by Browser</MudText>
            <MudText Typo="Typo.body1" Style="color: #ccc; max-width: 600px; margin-bottom: 30px;">
                Your browser has disabled camera access because this connection is not considered secure. Modern browsers require <b>HTTPS</b> to use hardware features.
            </MudText>
            
            <MudPaper Class="pa-6 text-left" Style="max-width: 600px; width: 100%;">
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-3">How to fix this:</MudText>
                <ol style="line-height: 1.8;">
                    <li>Ensure you are accessing the site via <b>HTTPS</b> (e.g., <code>https://100.x.x.x:8443</code>).</li>
                    <li>If you get a privacy warning, click <b>Advanced -> Proceed</b>.</li>
                    <li>If using Chrome on a local network, go to <code>chrome://flags/#unsafely-treat-insecure-origin-as-secure</code>, enable it, and add this site's address.</li>
                </ol>
                <div class="mt-6 d-flex justify-center">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CheckCameraSupport">Check Again</MudButton>
                </div>
            </MudPaper>
        </div>
    }
    else
    {
        <ErrorBoundary>
            <ChildContent>
                <BlazorCameraStreamer.CameraStreamer @ref="_cameraStreamer"
                                Autostart="false"
                                Class="camera-background" />
                                
                <div style="position: fixed; top: 20px; left: 20px; z-index: 1000;">
                    <MudFab Class="@(_isCameraEnabled ? "active-camera-anim" : "")"
                            Color="@(_isCameraEnabled ? Color.Primary : Color.Default)" 
                            StartIcon="@Icons.Material.Filled.Cameraswitch" 
                            OnClick="OpenCameraSelection" />
                </div>
            </ChildContent>
            <ErrorContent>
                <div style="position: fixed; top: 10px; right: 10px; z-index: 1000;">
                    <MudAlert Severity="Severity.Warning">Camera unavailable. Please ensure you are accessing the site via HTTPS.</MudAlert>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    }

    <BackgroundSwitcher />
}

<div class="d-flex flex-column align-center justify-center" style="min-height: calc(100vh - 128px); width: 100%; position: relative; z-index: 1;">
    @if (!AuthService.IsLoggedIn)
    {
        <div class="qr-feedback-border @(_actionResultClass)"></div>

        @if (!string.IsNullOrEmpty(_actionMessage))
        {
            <div class="qr-action-message">
                <MudIcon Icon="@(_actionResultClass == "success" ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Logout)" 
                         Color="@(_actionResultClass == "success" ? Color.Success : Color.Error)" 
                         Style="font-size: 8rem;" />
                <MudText Typo="Typo.h2" Class="mt-6 font-weight-bold" Style="color: white;">@_actionMemberName</MudText>
                <MudText Typo="Typo.h3" Class="mt-2 text-white">@_actionMessage</MudText>
            </div>
        }

        <div class="d-flex gap-8 align-center">
            <MudButton Variant="Variant.Filled" 
                       Class="burn-in-protection"
                       StartIcon="@Icons.Material.Filled.Login"
                       IconSize="Size.Large"
                       OnClick="@(() => NavigationManager.NavigateTo("/login"))">
                Check In
            </MudButton>

            @if (_allowPublicRegistration)
            {
                <MudButton Variant="Variant.Filled" 
                           Class="burn-in-protection"
                           StartIcon="@Icons.Material.Filled.PersonAdd"
                           IconSize="Size.Large"
                           OnClick="@(() => NavigationManager.NavigateTo("/public-register"))">
                    New Member
                </MudButton>
            }
        </div>
        
        <MudPaper Class="mt-12 pa-4" Style="background: rgba(0,0,0,0.6); border-radius: 15px; z-index: 10;">
            <MudText Typo="Typo.h5" Style="color: white; font-weight: bold;">
                Show your QR code to the camera for instant Check-In/Out!
            </MudText>
        </MudPaper>
    }
    else if (AuthService.IsMember)
    {
        <div class="d-flex flex-column align-center justify-center" style="min-height: 80vh; z-index: 10;">
            @if (_showSuccessMessage)
            {
                <MudPaper Class="pa-12 d-flex flex-column align-center" Elevation="4" Style="width: 100%; max-width: 500px; background: rgba(255,255,255,0.9);">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" Style="font-size: 5rem;" />
                    <MudText Typo="Typo.h3" Class="mt-6">Thank you!</MudText>
                    <MudText Typo="Typo.h5" Class="mt-2 text-center">You have successfully @_successActionText.</MudText>
                    <MudText Typo="Typo.body1" Class="mt-8">Logging you out automatically in @_countdown seconds...</MudText>
                    <MudProgressLinear Color="Color.Success" Value="@(_countdown * 20)" Class="mt-6 w-100" />
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="LogoutNow" Class="mt-6">Logout Now</MudButton>
                </MudPaper>
            }
            else
            {
                <MudPaper Class="pa-12 d-flex flex-column align-center" Elevation="4" Style="width: 100%; max-width: 600px; background: rgba(255,255,255,0.9);">
                    <div class="d-flex justify-end w-100 mb-n10">
                        <MudIconButton Icon="@Icons.Material.Filled.LockReset" Color="Color.Default" OnClick="OpenChangePasswordDialog" />
                    </div>
                    
                    <MudIcon Icon="@Icons.Material.Filled.FlashOn" Size="Size.Large" Color="(_isMemberCheckedIn ? Color.Success : Color.Default)" Style="font-size: 5rem;" />
                    <MudText Typo="Typo.h3" Class="mt-6">Welcome, @AuthService.Username!</MudText>
                    <MudText Typo="Typo.h5" Class="mt-2 mb-10 text-center">
                        Status: @(_isMemberCheckedIn ? "You are currently Checked In" : "You are currently Checked Out")
                    </MudText>
                    
                    <div class="d-flex gap-8">
                        @if (!_isMemberCheckedIn)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="height: 120px; width: 220px; font-size: 1.5rem;" StartIcon="@Icons.Material.Filled.Login" OnClick="@(() => SelfCheckIn())">Check In</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Style="height: 120px; width: 220px; font-size: 1.5rem;" StartIcon="@Icons.Material.Filled.Logout" OnClick="SelfCheckOut">Check Out</MudButton>
                        }
                    </div>

                    <div class="mt-12 w-100">
                        <MudText Typo="Typo.caption" Align="Align.Center" Class="d-block grey-text">Session will expire in @_countdown seconds</MudText>
                        <MudProgressLinear Color="Color.Warning" Value="@(_countdown * 6.66)" Class="mt-2" />
                    </div>
                </MudPaper>
            }
        </div>
    }
    else if (AuthService.IsVolunteer)
    {
        <div style="width: 100%;">
            <MudText Typo="Typo.h3" Align="Align.Center" GutterBottom="true">Volunteer Dashboard</MudText>
            <MudGrid Class="mt-8">
                <MudItem xs="12" sm="@(AuthService.CanManageEvents ? 4 : 6)">
                    <MudPaper Class="pa-8 d-flex flex-column align-center" Elevation="4" Style="cursor: pointer; height: 100%" @onclick="@(() => NavigationManager.NavigateTo("/find-member"))">
                        <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Large" Color="Color.Primary" Style="font-size: 4rem;" />
                        <MudText Typo="Typo.h5" Class="mt-4">Find Member</MudText>
                        <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2">Search the master roster and check in members.</MudText>
                    </MudPaper>
                </MudItem>
                
                <MudItem xs="12" sm="@(AuthService.CanManageEvents ? 4 : 6)">
                    <MudPaper Class="pa-8 d-flex flex-column align-center" Elevation="4" Style="cursor: pointer; height: 100%" @onclick="@(() => NavigationManager.NavigateTo("/RecordView"))">
                        <MudIcon Icon="@Icons.Material.Filled.RunningWithErrors" Size="Size.Large" Color="Color.Secondary" Style="font-size: 4rem;" />
                        <MudText Typo="Typo.h5" Class="mt-4">Active Manifest</MudText>
                        <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2">View all members currently on-site.</MudText>
                    </MudPaper>
                </MudItem>

                @if (AuthService.CanManageEvents)
                {
                    <MudItem xs="12" sm="4">
                        <MudPaper Class="pa-8 d-flex flex-column align-center" Elevation="4" Style="cursor: pointer; height: 100%" @onclick="@(() => NavigationManager.NavigateTo("/events"))">
                            <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Large" Color="Color.Info" Style="font-size: 4rem;" />
                            <MudText Typo="Typo.h5" Class="mt-4">Manage Events</MudText>
                            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2">Add or schedule new events for the terminal.</MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </div>
    }
</div>