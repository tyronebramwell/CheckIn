@implements IDisposable
@inject AuthService AuthService

<MudNavMenu>
    @if (AuthService.IsLoggedIn)
    {
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
        
        @if (AuthService.CanViewData)
        {
            <MudNavLink Href="/find-member" Icon="@Icons.Material.Filled.PersonSearch">Find Member</MudNavLink>
            <MudNavLink Href="/MemberRoster" Icon="@Icons.Material.Filled.People">Member Roster</MudNavLink>
            <MudNavLink Href="/RecordView" Icon="@Icons.Material.Filled.RunningWithErrors">Active</MudNavLink>
            <MudNavLink Href="/AttendanceHistory" Icon="@Icons.Material.Filled.History">History</MudNavLink>
        }

        @if (AuthService.CanAddUsers)
        {
            <MudNavLink Href="/register-member" Icon="@Icons.Material.Filled.PersonAdd">Registration</MudNavLink>
        }

        @if (AuthService.CanManageVolunteers)
        {
            <MudNavLink Href="/volunteers" Icon="@Icons.Material.Filled.PeopleAlt">Volunteers</MudNavLink>
            <MudNavLink Href="/config" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
            <MudNavLink Href="/logs" Icon="@Icons.Material.Filled.ListAlt">System Logs</MudNavLink>
        }
        @if (AuthService.CanManageEvents)
        {
            <MudNavLink Href="/events" Icon="@Icons.Material.Filled.Event">Events</MudNavLink>
        }
    }
</MudNavMenu>

@code {
    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += StateHasChanged;
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= StateHasChanged;
    }
}
