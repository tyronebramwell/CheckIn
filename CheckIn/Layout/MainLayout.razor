@inherits LayoutComponentBase
<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
@if (!ShouldHideAppBar)
{
    <MudAppBar Elevation="1">
        @if (AuthService.IsLoggedIn)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        }
        <MudText Typo="Typo.h5" Class="ml-3">Check In System</MudText>
        <MudSpacer />
        @if (AuthService.IsLoggedIn)
        {
            <MudText Class="mr-4">@AuthService.Username</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="Logout">Logout</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="Login">Login</MudButton>
        }
    </MudAppBar>
}
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
