<MudDialog>
    <TitleContent>Add Volunteer</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_username" Label="Username" Variant="Variant.Outlined" />
        <MudTextField @bind-Value="_email" Label="Email Address" Variant="Variant.Outlined" InputType="InputType.Email" Class="mt-4" />
        <MudTextField @bind-Value="_password" Label="Password" Variant="Variant.Outlined" InputType="InputType.Password" Class="mt-4" />
        
        <MudText Typo="Typo.subtitle2" Class="mt-6">Permissions</MudText>
        <MudCheckBox @bind-Value="_canViewData" Label="Can View Data" Color="Color.Primary" />
        <MudCheckBox @bind-Value="_canAddUsers" Label="Can Add Members" Color="Color.Primary" />
        <MudCheckBox @bind-Value="_canManageEvents" Label="Can Manage Events" Color="Color.Primary" />
        <MudCheckBox @bind-Value="_canManageVolunteers" Label="Can Manage Volunteers (Admin)" Color="Color.Primary" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Create</MudButton>
    </DialogActions>
</MudDialog>
