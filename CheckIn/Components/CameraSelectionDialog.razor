<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Camera Settings</MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-4">
            <MudSwitch T="bool" @bind-Value="_isCameraEnabled" Label="Enable Camera" Color="Color.Primary" />

            @if (Cameras == null)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else if (Cameras.Length == 0)
            {
                <MudText Color="Color.Error">No cameras found. Please check permissions.</MudText>
            }
            else
            {
                <MudSelect T="string" Label="Select Camera Device" @bind-Value="_selectedDeviceId" Disabled="!_isCameraEnabled">
                    @foreach (var cam in Cameras)
                    {
                        <MudSelectItem Value="@cam.DeviceId">
                            @GetCameraDisplayName(cam)
                        </MudSelectItem>
                    }
                </MudSelect>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Apply">Apply</MudButton>
    </DialogActions>
</MudDialog>
