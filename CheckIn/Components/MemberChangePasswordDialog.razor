<MudDialog>
    <DialogContent>
        <MudText GutterBottom="true">Enter a new password for your account.</MudText>
        <MudTextField T="string" Label="New Password" @bind-Value="_newPassword" Variant="Variant.Outlined" InputType="InputType.Password" Class="mt-4" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Update Password</MudButton>
    </DialogActions>
</MudDialog>
