<MudDialog>
    <TitleContent>Edit Volunteer</TitleContent>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-4">@Volunteer.Username</MudText>
        
        <MudTextField @bind-Value="_email" Label="Email Address" Variant="Variant.Outlined" InputType="InputType.Email" Class="mb-6" />
        
        <MudText Typo="Typo.subtitle2">Permissions</MudText>
        <MudCheckBox @bind-Value="_canViewData" Label="Can View Data" Color="Color.Primary" />
        <MudCheckBox @bind-Value="_canAddUsers" Label="Can Add Members" Color="Color.Primary" />
        <MudCheckBox @bind-Value="_canManageEvents" Label="Can Manage Events" Color="Color.Primary" />
        <MudCheckBox @bind-Value="_canManageVolunteers" Label="Can Manage Volunteers (Admin)" Color="Color.Primary" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>
