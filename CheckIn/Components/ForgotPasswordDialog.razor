<MudDialog>
    <TitleContent>Reset Password</TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">Enter your email address and we'll send you a temporary 6-character password.</MudText>
        <MudTextField @bind-Value="_email" Label="Email Address" Variant="Variant.Outlined" InputType="InputType.Email" Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="_isProcessing">
            @if (_isProcessing) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/> }
            Send Temporary Password
        </MudButton>
    </DialogActions>
</MudDialog>
