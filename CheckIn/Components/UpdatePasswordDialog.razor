<MudDialog>
    <TitleContent>Update Password</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_newPassword" Label="New Password" Variant="Variant.Outlined" InputType="InputType.Password" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Update</MudButton>
    </DialogActions>
</MudDialog>
