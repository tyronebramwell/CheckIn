<style>
    .snake-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
    }

    .snake-body {
        position: absolute;
        width: 20px;
        height: 20px;
        background: #4CAF50;
        border-radius: 4px;
        opacity: 0.7;
    }

    .snake-food {
        position: absolute;
        width: 15px;
        height: 15px;
        background: #FF5252;
        border-radius: 50%;
        animation: pulse 1s infinite alternate;
    }

    @@keyframes pulse {
        from { transform: scale(1); }
        to { transform: scale(1.2); }
    }
</style>

<div class="snake-container">
    @foreach (var segment in _snake)
    {
        <div class="snake-body" style="left: @(segment.X)px; top: @(segment.Y)px;"></div>
    }
    @foreach (var food in _foods)
    {
        <div class="snake-food" style="left: @(food.X)px; top: @(food.Y)px;"></div>
    }
</div>

@code {
    private List<Point> _snake = new();
    private List<Point> _foods = new();
    private int _dirX = 1;
    private int _dirY = 0;
    private System.Timers.Timer? _timer;
    private int _step = 22;

    private struct Point { public int X; public int Y; }

    protected override void OnInitialized()
    {
        for (int i = 5; i >= 0; i--) _snake.Add(new Point { X = 100 + i * _step, Y = 100 });
        for (int i = 0; i < 5; i++) SpawnFood();

        _timer = new System.Timers.Timer(150);
        _timer.Elapsed += (s, e) => { 
            MoveSnake(); 
            InvokeAsync(StateHasChanged);
        };
        _timer.Start();
    }

    private void MoveSnake()
    {
        var head = _snake[0];
        
        // AI logic: head towards nearest food
        if (_foods.Count > 0)
        {
            var food = _foods[0];
            if (food.X > head.X && _dirX != -1) { _dirX = 1; _dirY = 0; }
            else if (food.X < head.X && _dirX != 1) { _dirX = -1; _dirY = 0; }
            else if (food.Y > head.Y && _dirY != -1) { _dirX = 0; _dirY = 1; }
            else if (food.Y < head.Y && _dirY != 1) { _dirX = 0; _dirY = -1; }
        }

        var newHead = new Point { X = head.X + _dirX * _step, Y = head.Y + _dirY * _step };

        // Wrap around screen roughly (since we don't have JS window size here easily, we use 100vw approx)
        if (newHead.X < 0) newHead.X = 1200;
        if (newHead.X > 1200) newHead.X = 0;
        if (newHead.Y < 0) newHead.Y = 800;
        if (newHead.Y > 800) newHead.Y = 0;

        _snake.Insert(0, newHead);
        
        bool ate = false;
        for (int i = 0; i < _foods.Count; i++)
        {
            if (Math.Abs(_foods[i].X - newHead.X) < _step && Math.Abs(_foods[i].Y - newHead.Y) < _step)
            {
                _foods.RemoveAt(i);
                SpawnFood();
                ate = true;
                break;
            }
        }

        if (!ate) _snake.RemoveAt(_snake.Count - 1);
    }

    private void SpawnFood()
    {
        var rand = new Random();
        _foods.Add(new Point { X = rand.Next(50, 1100), Y = rand.Next(50, 700) });
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }
}
